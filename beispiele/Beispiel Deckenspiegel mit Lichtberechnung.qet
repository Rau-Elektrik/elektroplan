            <input uuid="{f64893ec-7112-51fd-b404-577cfb52f137}" x="26" y="856" text="Verfahren: Wirkungsgradverfahren  n = Ēm · A / (Φ · ηR · MF);  Ē = n · Φ · ηR · MF / A;  Raumindex k = 2 · A / (h · U), h = Lichtpunkthöhe über Nutzebene." rotation="0" font="Arial,5.5,-1,5,50,0,0,0,0,0,Regular" />
            <input uuid="{0300bb98-c6a1-5cea-89a9-63129201583f}" x="26" y="866" text="Wartungsfaktor MF = 0,80 (LED, saubere Räume, Wartung alle 3 Jahre). Reflexionsgrade: Decke 0,7 / Wand 0,5 / Boden 0,2. ηR: Näherungswerte für direkt strahlende LED-Leuchten (direkt/indirekt × 0,85)." rotation="0" font="Arial,5.5,-1,5,50,0,0,0,0,0,Regular" />
